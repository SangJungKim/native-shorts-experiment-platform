EXPO_PUBLIC_SUPABASE_URL=http://YOUR_MAC_LAN_IP:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# A physical phone cannot reach your Mac through 127.0.0.1. Replace
# YOUR_MAC_LAN_IP with the Mac's address on the same Wi-Fi network.
# Never place a service-role key or another server secret in this file.
# For TestFlight, configure these EXPO_PUBLIC values in the EAS preview
# environment instead of committing a hosted .env file.
