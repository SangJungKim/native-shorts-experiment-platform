# Values are printed by `npm run db:start`. These placeholders are safe examples.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Never expose SUPABASE_SERVICE_ROLE_KEY to either client bundle.
# Do not commit access tokens, passwords, service-role keys, or production credentials.
